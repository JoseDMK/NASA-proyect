@model NASA.Models.Experimento

@{
    ViewData["Title"] = "AgregarResultado";
}

<h1>AgregarResultado</h1>

<h4>Experimento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="AgregarResultado">
            <input type="hidden" asp-for="Nombre" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="ResultadoEsperado" class="control-label"></label>
                <select asp-for="ResultadoEsperado" class="form-control">
                    <option value="">-- Seleccione --</option>
                    <option value="true">Sí</option>
                    <option value="false">No</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="Observaciones" class="control-label"></label>
                <input asp-for="Observaciones" class="form-control" />
                <span asp-validation-for="Observaciones" class="text-danger"></span>
            </div>
            <br />
            <div class="form-group">
                <input type="submit" value="Guardar" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">Volver</a>
            </div>
            <br />
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
